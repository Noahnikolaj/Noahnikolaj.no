{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noahnikolaj-no",
  "compatibility_date": "2026-11-01",
  // Static files only: `next build` exports the whole site to out/, and
  // Cloudflare serves it straight from its asset store. There is no Worker
  // script, so requests use no CPU time and are free and unlimited.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "noahnikolaj.no", "custom_domain": true },
    { "pattern": "www.noahnikolaj.no", "custom_domain": true }
  ]
}
