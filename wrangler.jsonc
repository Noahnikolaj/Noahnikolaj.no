{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noahnikolaj-no",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backs next/image, replacing Vercel's image optimizer.
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "noahnikolaj-no"
    }
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "noahnikolaj.no", "custom_domain": true },
    { "pattern": "www.noahnikolaj.no", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
